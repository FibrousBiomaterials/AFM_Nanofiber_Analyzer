{
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --delete:*)",
      "Bash(git push -d:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git clean:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)",
      "Bash(git tag -d:*)",
      "Bash(git update-ref -d:*)",
      "Bash(git reflog expire:*)",
      "Bash(git gc:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(unlink:*)",
      "Bash(shred:*)",
      "Bash(xargs rm:*)",
      "Bash(find *-delete*)",
      "Bash(cmd //c del:*)",
      "Bash(cmd //c rd:*)",
      "Bash(cmd //c rmdir:*)",
      "Bash(cmd /c del:*)",
      "Bash(cmd /c rd:*)",
      "Bash(cmd /c rmdir:*)",
      "PowerShell(Remove-Item:*)",
      "PowerShell(rm:*)",
      "PowerShell(ri:*)",
      "PowerShell(del:*)",
      "PowerShell(erase:*)",
      "PowerShell(rd:*)",
      "PowerShell(rmdir:*)",
      "PowerShell(cmd /c del:*)",
      "PowerShell(cmd /c rd:*)",
      "PowerShell(cmd /c rmdir:*)",
      "PowerShell([System.IO.File]::Delete*)",
      "PowerShell([System.IO.Directory]::Delete*)",
      "PowerShell([IO.File]::Delete*)",
      "PowerShell([IO.Directory]::Delete*)"
    ],
    "allow": [
      "Bash(.venv/Scripts/python.exe scripts/trash.py:*)",
      "PowerShell(.venv\\Scripts\\python.exe scripts\\trash.py:*)",
      "PowerShell(.venv\\Scripts\\python.exe scripts/trash.py:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git commit --amend:*)",
      "Bash(git rm:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_hook.sh\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/detection_claim_prime.py\""
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_hook.sh\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/question_first.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_hook.sh\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/question_first.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_hook.sh\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/doc_code_reminder.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_hook.sh\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/detection_claim_guard.py\""
          }
        ]
      }
    ]
  }
}
