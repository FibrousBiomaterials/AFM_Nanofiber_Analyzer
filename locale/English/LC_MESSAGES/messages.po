msgstr "BG Correction"

#: guis/GUI01_Image_Preprocessor.py:339
msgid "二値化/成分処理"
msgstr "Binarization/Component Processing"

#: guis/GUI01_Image_Preprocessor.py:340
msgid "細線化"
msgstr "Skeletonization"

#: guis/GUI01_Image_Preprocessor.py:341
