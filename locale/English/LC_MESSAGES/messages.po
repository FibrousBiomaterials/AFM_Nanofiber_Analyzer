msgid "除外が無くなったため、除外ファイルを削除しました: {path}"
msgstr "No exclusions left, so the exclusion file was deleted: {path}"

#: guis/GUI04_Tracking_fiber.py:3685
#, python-brace-format
msgid "連結を保存しました（フィブリル {n} 本 / 断片 {m} 本）: {path}"
msgstr "Saved the connection ({n} fibril(s) from {m} fragment(s)): {path}"

#: guis/GUI04_Tracking_fiber.py:3691
#, python-brace-format
