msgid "連結部の高さを決めるために平均する端点サンプル数。"
msgstr ""
"Number of endpoint samples averaged to determine the height of the "
"connection."

#: guis/GUI04_Tracking_fiber.py:7181
msgid "高さ差の許容比"
msgstr "Allowed height-difference ratio"

#: guis/GUI04_Tracking_fiber.py:7182
