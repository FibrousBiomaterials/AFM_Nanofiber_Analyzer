msgstr ""
"Connect only fragments whose median heights differ relatively by at most "
"this value. Larger is more permissive."

#: guis/GUI04_Tracking_fiber.py:7183
msgid "交差ノイズのトリミング点数"
msgstr "Trim points for crossing noise"

#: guis/GUI04_Tracking_fiber.py:7184
