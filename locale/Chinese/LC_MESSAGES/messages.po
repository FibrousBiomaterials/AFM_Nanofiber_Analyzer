#, python-brace-format
msgid ""
"[{g}] {mode} 重みの有効標本数は {neff:.1f} 本（計測した {n} 本）で、最大の重みを持つ 1 本が重みの合計の "
"{share:.0%} を占めます。"
msgstr "[{g}] {mode} 权重的有效样本量为 {neff:.1f} 根（实测 {n} 根），权重最大的 1 根占权重总和的 {share:.0%}。"

#: guis/GUI03_Fiber_Morphology_Statistics.py:5852
#, python-brace-format
msgid ""
"[{g}] 長さ: {total} 本のうち {n} 本 ({share:.0%}) が枠に達し、ほかに {k} "
"本が交差などで切れた端を持ちます。どちらの長さも下限値です。"
msgstr ""
"[{g}] 长度：{total} 根中有 {n} 根 ({share:.0%}) 到达边框，另有 {k} "
"根的端部在交叉等处被切断。这两类长度都是下限值。"

#: guis/GUI03_Fiber_Morphology_Statistics.py:5867
#, python-brace-format
msgid "[{g}] キンクを判定した尺度: 見かけの幅の中央値 {w:.1f} nm"
msgstr "[{g}] 判定扭结的尺度：表观宽度中位数 {w:.1f} nm"

#: guis/GUI03_Fiber_Morphology_Statistics.py:5873
#, python-brace-format
msgid "[{g}] 背景の画素ノイズの中央値: {n:.3f} nm"
msgstr "[{g}] 背景像素噪声的中位数：{n:.3f} nm"

#: guis/GUI03_Fiber_Morphology_Statistics.py:5881
#, python-brace-format
msgid "どのグループからも {param} のデータを得られませんでした。ログを確認してください。"
msgstr "未能从任何组获取 {param} 数据。请查看日志。"

#: guis/GUI03_Fiber_Morphology_Statistics.py:5891
#: guis/GUI03_Fiber_Morphology_Statistics.py:6122
msgid "ヒストグラム範囲の準備に失敗しました。"
msgstr "直方图范围准备失败。"

#: guis/GUI03_Fiber_Morphology_Statistics.py:5927
#, python-brace-format
msgid "[{grp}] 標本が {n} 個しかないため、ヒストグラムの形状は解釈できません。テーブルの median と IQR を参照してください。"
msgstr "[{grp}] 样本仅有 {n} 个，无法解读直方图的形状。请参考表中的 median 与 IQR。"

#: guis/GUI03_Fiber_Morphology_Statistics.py:5941
msgid "比較には 2 群以上が必要です。"
msgstr "比较至少需要两个组。"

#: guis/GUI03_Fiber_Morphology_Statistics.py:5944
#, python-brace-format
msgid "{unit} 集計の標本は独立観測ではないため検定しません。{fiber} か {image} の集計に切り替えてください。"
msgstr "按 {unit} 汇总的样本并非独立观测，因此不进行检验。请切换到 {fiber} 或 {image} 单位。"

#: guis/GUI03_Fiber_Morphology_Statistics.py:5962
#, python-brace-format
msgid ""
"{km} の標本は重み付きのため検定しません。枠で切れた長さを補正して検定するには、枠の扱いを {ml} に、集計単位を {image} "
"にしてください。{ml} は交差で切れた長さを補正しません。"
msgstr ""
"{km} 的样本是加权样本，因此不进行检验。如需在校正边框截断长度的同时进行检验，请将边框处理设为 {ml}，并将汇总单位设为 "
"{image}。{ml} 不校正在交叉处被切断的长度。"

#: guis/GUI03_Fiber_Morphology_Statistics.py:5969
#, python-brace-format
msgid ""
"{fiber} 集計の {ml} 補正の標本は重み付きのため検定しません。補正したまま検定するには {image} "
"の集計に切り替えてください。各画像の重み付き中央値を検定します。"
msgstr ""
"按 {fiber} 汇总的 {ml} 校正样本是加权样本，因此不进行检验。如需在保留校正的同时进行检验，请切换到 {image} "
"汇总，此时检验每幅图像的加权中位数。"

#: guis/GUI03_Fiber_Morphology_Statistics.py:5980
#, python-brace-format
msgid "群間比較に失敗しました: {err}"
msgstr "组间比较失败: {err}"

#: guis/GUI03_Fiber_Morphology_Statistics.py:6092
msgid "=== エラー/注意（処理は継続しました） ==="
msgstr "=== 错误/注意（处理已继续） ==="

#: guis/GUI03_Fiber_Morphology_Statistics.py:6242
msgid "主検定 Mann-Whitney は Holm 補正後（括弧内は補正前）。KS は補正なしの参考値"
msgstr "主检验 Mann-Whitney 为 Holm 校正后（括号内为校正前）。KS 为未校正的参考值"

#: guis/GUI03_Fiber_Morphology_Statistics.py:6244
msgid "主検定は Mann-Whitney（2 群のため補正不要）。KS は参考値"
msgstr "主检验为 Mann-Whitney（两组无需校正）。KS 为参考值"

#: guis/GUI03_Fiber_Morphology_Statistics.py:6703
#: guis/GUI03_Fiber_Morphology_Statistics.py:6719
#: guis/GUI03_Fiber_Morphology_Statistics.py:6808
