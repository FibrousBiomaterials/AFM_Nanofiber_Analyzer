#: guis/GUI01_Image_Preprocessor.py:4183
msgid "解析条件（次回解析時にのみ反映）"
msgstr "解析条件（仅在下次解析时生效）"

#: guis/GUI01_Image_Preprocessor.py:4294
msgid "BGCalibrator"
msgstr "BGCalibrator"

#: guis/GUI01_Image_Preprocessor.py:4309
msgid "bg_method"
msgstr "bg_method"

#: guis/GUI01_Image_Preprocessor.py:4310
msgid "背景推定方式（下の説明参照）。選択に応じて使うパラメータのみ有効化されます"
msgstr "背景估计方法（见下方说明）。只启用所选方法使用的参数。"

#: guis/GUI01_Image_Preprocessor.py:4316
msgid ""
"trendfill : 勾配リッジ検出 + 2次トレンド除去 + "
"最近傍充填。勾配で繊維マスクを作り、試料傾斜を2次曲面で除いてから穴を埋める。汎用だがリッジ検出パラメータの調整が必要（1.0.0 では "
"'inpaint' という名前）"
msgstr ""
"trendfill：梯度脊线检测 + 二次趋势面去除 + "
"最近邻背景填充。根据梯度生成纤维掩膜，先用二次曲面去除样品倾斜，再填充空洞。通用性高，但需要调整脊线检测参数（在 1.0.0 中名为 "
"'inpaint'）。"

#: guis/GUI01_Image_Preprocessor.py:4317
msgid "tophat : 形態学的opening。tophat_se_size より細い明るい構造を前景として除去。マスク不要・高速・一様性に優れる"
msgstr "tophat：形态学 opening。将比 tophat_se_size 更细的亮结构作为前景去除。无需掩膜、速度快、均匀性好。"

#: guis/GUI01_Image_Preprocessor.py:4318
msgid ""
"spline1d : 2次トレンド除去 + 行/列ごとの1D "
"B-スプライン補間。縞ノイズに有効。ライン端は外挿せず自ラインの水準を保持。spline1d_axis で縞の向きを選択"
msgstr ""
"spline1d：二次趋势面去除 + 按行/列进行 1D B 样条插值。对条纹噪声有效。两端不做外推，而是保持该行/列自身的基准水平。通过 "
"spline1d_axis 选择条纹方向。"

#: guis/GUI01_Image_Preprocessor.py:4331
msgid "[tophat時のみ] 構造要素直径"
msgstr "[仅 tophat] 结构元素直径"

#: guis/GUI01_Image_Preprocessor.py:4332
msgid "最大ファイバー幅の2〜3倍。奇数(偶数は+1)"
msgstr "设为最大纤维宽度的 2-3 倍。使用奇数（偶数会 +1）。"

#: guis/GUI01_Image_Preprocessor.py:4335
msgid ""
"[spline1d時のみ] "
"除去する縞の向き。'y'=横縞(各走査ラインが上下にずれるノイズ)を除去/各列を縦に補間。'x'=縦縞を除去/各行を横に補間(良好な結果が多い)"
msgstr ""
"[仅 spline1d] 要去除的条纹方向。'y' 去除横向条纹（各扫描线发生上下偏移的噪声）并对各列纵向插值。'x' "
"去除纵向条纹并对各行横向插值（通常效果较好）。"

#: guis/GUI01_Image_Preprocessor.py:4338
msgid "[spline1d時のみ] 行/列スプライン order。実用範囲1〜3 (2=旧pandas互換)。点数不足の行は線形に自動フォールバック"
msgstr "[仅 spline1d] 行/列样条 order。实用范围 1-3（2=旧 pandas 兼容）。点数不足的行会自动回退为线性。"

#: guis/GUI01_Image_Preprocessor.py:4341
msgid "[trendfill, spline1d時] 背景範囲（中心±sigma*係数）を決める係数"
msgstr "[trendfill, spline1d] 决定背景范围（中心 ± sigma * 系数）的系数。"

#: guis/GUI01_Image_Preprocessor.py:4343
msgid "[trendfill, spline1d時] [1,0,-1]の急変を繊維として除外する距離しきい値"
msgstr "[trendfill, spline1d] 将 [1,0,-1] 等急变作为纤维排除的距离阈值"

#: guis/GUI01_Image_Preprocessor.py:4345
msgid "[trendfill, spline1d時] [1,-1]の急変が一定以上離れている場合に構造とみなすしきい値"
msgstr "[trendfill, spline1d] 当 [1,-1] 急变相隔一定距离以上时将其视为结构的阈值"

#: guis/GUI01_Image_Preprocessor.py:4348
msgid ""
"[trendfill, tophat, spline1d時] Savitzky-Golayフィルタの窓幅（平滑化範囲）。spline1d "
"ではライン端に保持する水準の平均本数も兼ねる"
msgstr ""
"[trendfill, tophat, spline1d] Savitzky-Golay 滤波器的窗口宽度（平滑范围）。在 spline1d "
"中还决定两端保持水平时的平均样本数。"

#: guis/GUI01_Image_Preprocessor.py:4350
msgid "[trendfill, tophat, spline1d時] Savitzky-Golayフィルタの多項式次数"
msgstr "[trendfill, tophat, spline1d] Savitzky-Golay 滤波器的多项式次数"

#: guis/GUI01_Image_Preprocessor.py:4353
msgid "中央値フィルタを最後にかける（点ノイズに強い）"
msgstr "最后应用中值滤波器（对点噪声鲁棒）"

#: guis/GUI01_Image_Preprocessor.py:4356
msgid "[trendfill, spline1d時] 繊維マスクを膨張させる画素数（0でdilationなし）"
msgstr "[trendfill, spline1d] 纤维掩膜膨胀的像素数（0 表示不膨胀）"

#: guis/GUI01_Image_Preprocessor.py:4358
msgid "[trendfill, spline1d時] dilation前にマスクから除外する連結成分の最小面積"
msgstr "[trendfill, spline1d] dilation 前从掩膜中排除的连通成分最小面积"

#: guis/GUI01_Image_Preprocessor.py:4359
msgid "1でフィルタ無効"
msgstr "设为 1 时禁用过滤器"

#: guis/GUI01_Image_Preprocessor.py:4369
msgid "Segmenter"
msgstr "Segmenter"

#: guis/GUI01_Image_Preprocessor.py:4370
msgid "局所しきい値の計算に使う窓サイズ"
msgstr "计算局部阈值使用的窗口大小"

#: guis/GUI01_Image_Preprocessor.py:4371
msgid "全体一律の2値化しきい値"
msgstr "全局统一的二值化阈值"

#: guis/GUI01_Image_Preprocessor.py:4372
msgid "小さい連結成分を消す面積しきい値"
msgstr "删除小连通成分的面积阈值"

#: guis/GUI01_Image_Preprocessor.py:4373
msgid "つながり成分を除くときの面積しきい値"
msgstr "去除连接成分时的面积阈值"

#: guis/GUI01_Image_Preprocessor.py:4374
msgid "つながり除去を実行するかどうか"
msgstr "是否执行连接去除"

#: guis/GUI01_Image_Preprocessor.py:4384
msgid "線分検出で線分とみなす最小長さ"
msgstr "线段检测中视为线段的最小长度"

#: guis/GUI01_Image_Preprocessor.py:4385
msgid "線っぽさ"
msgstr "线状程度"

#: guis/GUI01_Image_Preprocessor.py:4385
msgid "のしきい値"
msgstr "的阈值"

#: guis/GUI01_Image_Preprocessor.py:4386
msgid "高さが低い成分を消すしきい値"
msgstr "删除高度较低成分的阈值"

#: guis/GUI01_Image_Preprocessor.py:4388
msgid "しきい値で拾えなかった繊維をリッジフィルタで検出して追加する。1画像あたり数秒〜30秒遅くなる"
msgstr "用脊线滤波器检测阈值未能提取的纤维并补充。每张图像会慢数秒～30 秒"

#: guis/GUI01_Image_Preprocessor.py:4391
msgid "[ridge_recovery時] 追加するセグメントの最小長"
msgstr "[ridge_recovery] 补充线段的最小长度"

#: guis/GUI01_Image_Preprocessor.py:4393
msgid "[ridge_recovery時] リッジフィルタが探索する繊維半幅の下限"
msgstr "[ridge_recovery] 脊线滤波器搜索的纤维半宽下限"

#: guis/GUI01_Image_Preprocessor.py:4395
msgid "[ridge_recovery時] リッジフィルタが探索する繊維半幅の上限"
msgstr "[ridge_recovery] 脊线滤波器搜索的纤维半宽上限"

#: guis/GUI01_Image_Preprocessor.py:4397
msgid "Skeletonizer"
msgstr "Skeletonizer"

#: guis/GUI01_Image_Preprocessor.py:4398
msgid "分岐点が低い高さか判定するしきい値"
msgstr "判断分支部点是否为低高度的阈值"

#: guis/GUI01_Image_Preprocessor.py:4399
msgid "枝とみなす短い線を追跡する最大長"
msgstr "视为分支的短线最大追踪长度"

#: guis/GUI01_Image_Preprocessor.py:4400
msgid "小さすぎる線分（ノイズ）を削除する面積しきい値"
msgstr "删除过小线段（噪声）的面积阈值"

#: guis/GUI01_Image_Preprocessor.py:4401
msgid "骨格上の小ループ（マスクの穴由来の二重線）を1本に潰す最大囲み面積。0で無効"
msgstr "将骨架上的小环（掩膜孔洞造成的双线）压缩为单线的最大包围面积。0 为禁用"

#: guis/GUI01_Image_Preprocessor.py:4402
msgid "高さに関係なく除去する行き止まりの短い枝の最大長。画素単位のため解像度に応じて調整。0で無効"
msgstr "不论高度一律移除的短小末端分支的最大长度。以像素为单位，请根据扫描分辨率调整。0 为禁用"

#: guis/GUI01_Image_Preprocessor.py:4404
msgid "Kinkdetector"
msgstr "Kinkdetector"

#: guis/GUI01_Image_Preprocessor.py:4405
msgid "折れ線近似の3点のなす角がこの値以下ならkink判定"
msgstr "折线逼近中3点夹角小于此值则判定为扭结（kink）"

#: guis/GUI01_Image_Preprocessor.py:4417
msgid ""
"キンク判定と、長さ・高さ・曲率などすべての計測に使う中心線（W は繊維の見かけ幅）\n"
"half_max_025w：高さ断面の半値中点、W/4 で平滑化（既定）\n"
"half_max_05w：半値中点、0.5W で平滑化\n"
"skeleton_pixels：スケルトン画素そのもの\n"
"smoothed_skeleton_05w / 1w：スケルトンを 0.5W / 1W で平滑化\n"
"quarter_max：1/4 高さの中点\n"
"centroid：高さの重心\n"
"crest：断面の頂点（ねじれた繊維では軸から最も外れる）"
msgstr ""
"用于扭结判定以及长度、高度、曲率等所有测量的中心线（W 为纤维的表观宽度）\n"
"half_max_025w：高度截面的半高中点，以 W/4 平滑（默认）\n"
"half_max_05w：半高中点，以 0.5W 平滑\n"
"skeleton_pixels：骨架像素本身\n"
"smoothed_skeleton_05w / 1w：以 0.5W / 1W 平滑的骨架\n"
"quarter_max：1/4 高度的中点\n"
"centroid：高度重心\n"
"crest：截面顶点（在扭转纤维上偏离轴线最远）"

#: guis/GUI01_Image_Preprocessor.py:4446
msgid "縞ノイズの判定"
msgstr "条纹噪声的判定"

#: guis/GUI01_Image_Preprocessor.py:4450
msgid "フィードバック不良とみなす段差"
msgstr "视为反馈失控的台阶"

#: guis/GUI01_Image_Preprocessor.py:4464
msgid "隣接走査線間の高さ段差がこの値を超える箇所を走査の乱れとして数え、影響を受けた走査線の割合を一覧の「縞ノイズ率」列に表示します（解析条件には含まれません）"
msgstr "相邻扫描线之间的高度台阶超过此值的位置将被计为扫描扰动，受影响扫描线的比例显示在列表的“条纹噪声率”列中（不属于分析条件）"

#: guis/GUI01_Image_Preprocessor.py:4481
msgid "保存オプション"
msgstr "保存选项"

#: guis/GUI01_Image_Preprocessor.py:4486
msgid "解析時に元データを保存"
msgstr "解析时保存原始数据"

#: guis/GUI01_Image_Preprocessor.py:4492
msgid "ONのとき、背景補正前の元データも解析後の .b2z に original として同梱します（解析条件には含まれません）"
msgstr "开启时，背景校正前的原始数据也会作为 original 打包到解析后的 .b2z 中（不包含在解析条件中）"

#: guis/GUI01_Image_Preprocessor.py:4504
msgid "OK"
msgstr "确定"

#: guis/GUI01_Image_Preprocessor.py:4505
msgid "設定の保存"
msgstr "保存设置"

