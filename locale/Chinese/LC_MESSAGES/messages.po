msgstr "[trendfill, spline1d] dilation 前从掩膜中排除的连通成分最小面积"

#: guis/GUI01_Image_Preprocessor.py:4738
msgid "1でフィルタ無効"
msgstr "设为 1 时禁用过滤器"

