#!/bin/sh
# Pre-commit checks, run in order against the staged diff:
#   1. Sensitive information — credentials, personal information,
#      machine-local absolute paths, and locally defined blocked words.
#   2. Changelog — a change to the strict-regression goldens (i.e. the
#      numeric results moved) must come with a CHANGELOG.md entry.
# A finding in either check blocks the commit.
# The pre-push hook remains the final net for check 1: it also covers commit
# messages and merge commits, which this hook cannot see.
# コミット前の確認をステージ済み差分に対して順に実行する。
#   1. 機微情報 — 認証情報・個人情報・ローカル絶対パス・ローカル定義の NG ワード。
#   2. CHANGELOG — 厳密回帰テストの golden 値が変わる(= 数値結果が変わる)変更には
#      CHANGELOG.md への追記を必須にする。
# どちらかで検出された場合はコミットを中止する。
# 1 についてはコミットメッセージとマージコミットをこのフックでは検査できない
# ため、pre-push フックが最終防衛線として引き続き検査する。
#
# Enable once per clone (git never activates hooks automatically):
# クローンごとに一度だけ有効化する(git はフックを自動では有効化しない):
#   git config core.hooksPath .githooks
#
# Bypass for a single commit only when you are sure (use sparingly):
# 確信がある場合のみ、次で 1 回だけ迂回できる(乱用しないこと):
#   git commit --no-verify

set -u

repo_root=$(git rev-parse --show-toplevel) || exit 1
checker="$repo_root/scripts/check_sensitive.py"
changelog_checker="$repo_root/scripts/check_changelog.py"

# Fail closed: a missing checker script also blocks the commit.
# フェイルクローズ方針: 検査スクリプトが無い場合もコミットを中止する。
for script in "$checker" "$changelog_checker"; do
    if [ ! -f "$script" ]; then
        echo "pre-commit: $script not found; blocking commit (fail-closed)." >&2
        exit 1
    fi
done

# Prefer "python" (present in this project's venv/conda setups); fall back
# to python3, then to the Windows "py" launcher used by plain Git Bash.
if command -v python >/dev/null 2>&1; then
    py=python
elif command -v python3 >/dev/null 2>&1; then
    py=python3
elif command -v py >/dev/null 2>&1; then
    py="py -3"
else
    echo "pre-commit: no Python interpreter found; blocking commit (fail-closed)." >&2
    exit 1
fi

# $py is intentionally unquoted so "py -3" splits into command and argument.
# Run the sensitive-information check first: it is the one that must never be
# skipped, and stopping there keeps the changelog reminder out of the way while
# a leak is being fixed.
# 機微情報チェックを先に実行する。省略してはならないのはこちらであり、漏えいを
# 直している最中に CHANGELOG の指摘が混ざらないようにする。
$py "$checker" --staged || exit $?

exec $py "$changelog_checker" --staged
